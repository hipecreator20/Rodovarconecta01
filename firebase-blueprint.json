{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public corporate directory profile for an employee without sensitive PII",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "roleTitle": { "type": "string", "minLength": 2, "maxLength": 120 },
        "department": {
          "type": "string",
          "enum": ["Administrativo", "Operacional", "Recursos Humanos", "Financeiro", "Segurança", "Diretoria", "Logística"]
        },
        "accessLevel": {
          "type": "string",
          "enum": ["FUNCIONARIO", "ADMINISTRADOR", "DIRETORIA"]
        },
        "avatar": { "type": "string", "maxLength": 300 },
        "phoneExt": { "type": "string", "maxLength": 40 },
        "joinedAt": { "type": "string", "maxLength": 30 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "roleTitle", "department", "accessLevel", "avatar", "phoneExt", "joinedAt", "active", "createdAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for an employee (email and notification preferences)",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted RBAC marker forADMINISTRADOR and DIRETORIA roles",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["ADMINISTRADOR", "DIRETORIA"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Official corporate announcement published by Diretoria or Administrador",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 180 },
        "summary": { "type": "string", "minLength": 3, "maxLength": 400 },
        "content": { "type": "string", "minLength": 3, "maxLength": 5000 },
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "department": { "type": "string", "maxLength": 60 },
        "dateFormatted": { "type": "string", "maxLength": 30 },
        "coverImage": { "type": "string", "maxLength": 300 },
        "category": {
          "type": "string",
          "enum": ["Comunicado Geral", "Importante", "Urgente", "Recursos Humanos", "Segurança", "Operacional", "Eventos", "Diretoria"]
        },
        "priority": { "type": "string", "enum": ["Normal", "Importante", "Urgente"] },
        "targetAudience": { "type": "string", "maxLength": 60 },
        "requireReadConfirmation": { "type": "boolean" },
        "pinned": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "summary",
        "content",
        "authorId",
        "authorName",
        "department",
        "dateFormatted",
        "coverImage",
        "category",
        "priority",
        "targetAudience",
        "requireReadConfirmation",
        "pinned",
        "createdAt"
      ]
    },
    "AnnouncementComment": {
      "title": "AnnouncementComment",
      "description": "Employee comment on a corporate announcement",
      "type": "object",
      "properties": {
        "announcementId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "authorRole": { "type": "string", "maxLength": 120 },
        "authorAvatar": { "type": "string", "maxLength": 300 },
        "content": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "createdAtFormatted": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["announcementId", "authorId", "authorName", "authorRole", "authorAvatar", "content", "createdAtFormatted", "createdAt"]
    },
    "AnnouncementRead": {
      "title": "AnnouncementRead",
      "description": "Explicit read confirmation receipt by an employee",
      "type": "object",
      "properties": {
        "announcementId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "department": { "type": "string", "maxLength": 60 },
        "confirmedAt": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["announcementId", "userId", "userName", "department", "confirmedAt", "createdAt"]
    },
    "AnnouncementLike": {
      "title": "AnnouncementLike",
      "description": "Like reaction by an employee on an announcement",
      "type": "object",
      "properties": {
        "announcementId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["announcementId", "userId", "createdAt"]
    },
    "InternalRequest": {
      "title": "InternalRequest",
      "description": "Internal service request with 48-hour SLA protocol",
      "type": "object",
      "properties": {
        "protocol": { "type": "string", "maxLength": 30 },
        "requesterId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requesterName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "requesterDepartment": { "type": "string", "maxLength": 60 },
        "targetDepartment": { "type": "string", "maxLength": 60 },
        "subject": { "type": "string", "minLength": 3, "maxLength": 200 },
        "description": { "type": "string", "minLength": 3, "maxLength": 3000 },
        "priority": { "type": "string", "enum": ["Baixa", "Média", "Alta", "Urgente"] },
        "status": {
          "type": "string",
          "enum": ["Aberta", "Em análise", "Em andamento", "Aguardando funcionário", "Concluída", "Cancelada"]
        },
        "createdAtIso": { "type": "string", "maxLength": 40 },
        "originalDueAtIso": { "type": "string", "maxLength": 40 },
        "currentDueAtIso": { "type": "string", "maxLength": 40 },
        "attachmentName": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "protocol",
        "requesterId",
        "requesterName",
        "requesterDepartment",
        "targetDepartment",
        "subject",
        "description",
        "priority",
        "status",
        "createdAtIso",
        "originalDueAtIso",
        "currentDueAtIso",
        "createdAt",
        "updatedAt"
      ]
    },
    "RequestHistory": {
      "title": "RequestHistory",
      "description": "Audit log entry for changes to an internal request",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "action": { "type": "string", "minLength": 2, "maxLength": 400 },
        "note": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "actorId", "actorName", "action", "timestamp", "createdAt"]
    },
    "CorporateEvent": {
      "title": "CorporateEvent",
      "description": "Event on the corporate calendar",
      "type": "object",
      "properties": {
        "day": { "type": "string", "maxLength": 4 },
        "monthShort": { "type": "string", "maxLength": 10 },
        "dateIso": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 40 },
        "location": { "type": "string", "maxLength": 160 },
        "title": { "type": "string", "minLength": 2, "maxLength": 180 },
        "organizer": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "maxLength": 60 },
        "badgeLabel": {
          "type": "string",
          "enum": [
            "Importante",
            "Evento",
            "Reunião",
            "Treinamento",
            "TREINAMENTO SSMA",
            "REUNIÃO EXECUTIVA",
            "INTEGRAÇÃO RH"
          ]
        },
        "badgeColor": { "type": "string", "enum": ["red", "blue", "gray"] },
        "description": { "type": "string", "maxLength": 2000 },
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "day",
        "monthShort",
        "dateIso",
        "time",
        "location",
        "title",
        "organizer",
        "department",
        "badgeLabel",
        "badgeColor",
        "description",
        "authorId",
        "createdAt"
      ]
    },
    "EventAttendee": {
      "title": "EventAttendee",
      "description": "RSVP record for a corporate event",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "userId", "userName", "createdAt"]
    },
    "CorporateDocument": {
      "title": "CorporateDocument",
      "description": "Document entry in the corporate document library",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 180 },
        "category": {
          "type": "string",
          "enum": [
            "Políticas da Empresa",
            "Manual do Colaborador",
            "Recursos Humanos",
            "Segurança do Trabalho",
            "Formulários",
            "Treinamentos",
            "Documentos Administrativos"
          ]
        },
        "version": { "type": "string", "maxLength": 20 },
        "updatedAt": { "type": "string", "maxLength": 30 },
        "author": { "type": "string", "maxLength": 120 },
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "size": { "type": "string", "maxLength": 30 },
        "fileType": { "type": "string", "enum": ["PDF", "DOCX", "XLSX"] },
        "allowedDepartments": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 1500 },
        "contentPreview": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "category",
        "version",
        "updatedAt",
        "author",
        "authorId",
        "size",
        "fileType",
        "allowedDepartments",
        "description",
        "contentPreview",
        "createdAt"
      ]
    },
    "EmployeeInvite": {
      "title": "EmployeeInvite",
      "description": "Single-use temporary token invitation for a new employee",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "roleTitle": { "type": "string", "minLength": 2, "maxLength": 120 },
        "department": { "type": "string", "maxLength": 60 },
        "accessLevel": { "type": "string", "enum": ["FUNCIONARIO", "ADMINISTRADOR", "DIRETORIA"] },
        "token": { "type": "string", "maxLength": 64 },
        "expiresAt": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["Pendente", "Ativado", "Expirado"] },
        "createdBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "fullName",
        "email",
        "roleTitle",
        "department",
        "accessLevel",
        "token",
        "expiresAt",
        "status",
        "createdBy",
        "createdAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative audit log entry",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "maxLength": 40 },
        "actorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actor": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["FUNCIONARIO", "ADMINISTRADOR", "DIRETORIA"] },
        "action": { "type": "string", "maxLength": 80 },
        "details": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["timestamp", "actorId", "actor", "role", "action", "details", "createdAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Corporate private conversation or department group chat",
      "type": "object",
      "properties": {
        "isGroup": { "type": "boolean" },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "roleOrDept": { "type": "string", "maxLength": 160 },
        "department": { "type": "string", "maxLength": 60 },
        "pinnedNotice": { "type": "string", "maxLength": 400 },
        "participantsCount": { "type": "integer" },
        "createdBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["isGroup", "name", "roleOrDept", "department", "participantsCount", "createdBy", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message inside a private chat or corporate group",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "senderRole": { "type": "string", "maxLength": 120 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "timestamp": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["delivered", "read"] },
        "attachmentName": { "type": "string", "maxLength": 200 },
        "attachmentSize": { "type": "string", "maxLength": 30 },
        "pinned": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "senderId", "senderName", "text", "timestamp", "status", "createdAt"]
    },
    "ChatParticipant": {
      "title": "ChatParticipant",
      "description": "Participant membership record for a chat thread or corporate group",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "department": { "type": "string", "maxLength": 60 },
        "roleTitle": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "userId", "userName", "department", "roleTitle", "createdAt"]
    },
    "CorporateNotification": {
      "title": "CorporateNotification",
      "description": "Real-time corporate alert or notification targeted to a user or broadcast",
      "type": "object",
      "properties": {
        "recipientId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": {
          "type": "string",
          "enum": ["comunicado", "mensagem", "solicitacao", "alerta_sla", "evento", "documento", "prazo"]
        },
        "dotColor": { "type": "string", "enum": ["red", "blue"] },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "subtitle": { "type": "string", "minLength": 2, "maxLength": 240 },
        "timeLabel": { "type": "string", "maxLength": 40 },
        "read": { "type": "boolean" },
        "targetSection": { "type": "string", "maxLength": 40 },
        "targetId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "recipientId",
        "type",
        "dotColor",
        "title",
        "subtitle",
        "timeLabel",
        "read",
        "targetSection",
        "createdAt"
      ]
    },
    "FreightFinancialRecord": {
      "title": "FreightFinancialRecord",
      "description": "Financial and operational freight transport contract record",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 20 },
        "createdAtDate": { "type": "string", "maxLength": 20 },
        "createdAtIso": { "type": "string", "maxLength": 40 },
        "empresaMarca": { "type": "string", "enum": ["RODOVAR", "VL TRANSPORTES", "AXD"] },
        "dataCarregamento": { "type": "string", "maxLength": 20 },
        "unidadeOperacional": { "type": "string", "enum": ["BA - Salvador", "SP - Guarulhos"] },
        "comercialResponsavel": { "type": "string", "maxLength": 120 },
        "expedicaoResponsavel": { "type": "string", "maxLength": 120 },
        "cliente": { "type": "string", "minLength": 2, "maxLength": 120 },
        "telefoneCliente": { "type": "string", "maxLength": 30 },
        "motoristaNome": { "type": "string", "maxLength": 120 },
        "motoristaTelefone": { "type": "string", "maxLength": 30 },
        "emergenciaNome": { "type": "string", "maxLength": 120 },
        "emergenciaTelefone": { "type": "string", "maxLength": 30 },
        "origem": { "type": "string", "minLength": 2, "maxLength": 140 },
        "destino": { "type": "string", "minLength": 2, "maxLength": 140 },
        "dataColeta": { "type": "string", "maxLength": 20 },
        "dataEntrega": { "type": "string", "maxLength": 20 },
        "valorFreteEmpresa": { "type": "number" },
        "valorFreteMotorista": { "type": "number" },
        "regraTipo": { "type": "string", "enum": ["70_30", "INTEGRAL_100", "PERSONALIZADO"] },
        "regraLabel": { "type": "string", "maxLength": 40 },
        "percentualAdiantamento": { "type": "number" },
        "percentualSaldo": { "type": "number" },
        "valorTotal": { "type": "number" },
        "valorAdiantamento": { "type": "number" },
        "valorSaldo": { "type": "number" },
        "favorecido": { "type": "string", "minLength": 2, "maxLength": 120 },
        "banco": { "type": "string", "maxLength": 80 },
        "agencia": { "type": "string", "maxLength": 30 },
        "conta": { "type": "string", "maxLength": 40 },
        "tipoChavePix": { "type": "string", "enum": ["CPF/CNPJ", "Celular", "E-mail", "Chave Aleatória"] },
        "chavePix": { "type": "string", "maxLength": 120 },
        "status": {
          "type": "string",
          "enum": ["Pendente Adiantamento", "Adiantamento Pago", "Aguardando Entrega", "Pendente Saldo", "Pago"]
        },
        "adiantamentoPago": { "type": "boolean" },
        "adiantamentoPagoEm": { "type": "string", "maxLength": 40 },
        "codigoTransacaoAdiantamento": { "type": "string", "maxLength": 60 },
        "entregaConfirmada": { "type": "boolean" },
        "entregaConfirmadaEm": { "type": "string", "maxLength": 40 },
        "saldoPago": { "type": "boolean" },
        "saldoPagoEm": { "type": "string", "maxLength": 40 },
        "codigoTransacaoSaldo": { "type": "string", "maxLength": 60 },
        "observacoes": { "type": "string", "maxLength": 1000 },
        "solicitanteNome": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "code",
        "createdAtDate",
        "createdAtIso",
        "cliente",
        "origem",
        "destino",
        "dataColeta",
        "dataEntrega",
        "regraTipo",
        "regraLabel",
        "percentualAdiantamento",
        "percentualSaldo",
        "valorTotal",
        "valorAdiantamento",
        "valorSaldo",
        "favorecido",
        "banco",
        "agencia",
        "conta",
        "tipoChavePix",
        "chavePix",
        "status",
        "adiantamentoPago",
        "entregaConfirmada",
        "saldoPago",
        "solicitanteNome",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/public/{profileId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public directory profile for employees"
    },
    "/users/{userId}/private/{infoId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated private PII record for an employee"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted role lookup for ADMINISTRADOR and DIRETORIA"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Corporate announcements on the official mural"
    },
    "/announcements/{announcementId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/AnnouncementComment" },
      "description": "Comments on a corporate announcement"
    },
    "/announcements/{announcementId}/reads/{userId}": {
      "schema": { "$ref": "#/entities/AnnouncementRead" },
      "description": "Mandatory read confirmation receipts per employee"
    },
    "/announcements/{announcementId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/AnnouncementLike" },
      "description": "Likes per employee on an announcement"
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/InternalRequest" },
      "description": "Internal employee service requests with 48h SLA"
    },
    "/requests/{requestId}/history/{historyId}": {
      "schema": { "$ref": "#/entities/RequestHistory" },
      "description": "Audit history of a service request"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/CorporateEvent" },
      "description": "Corporate calendar events"
    },
    "/events/{eventId}/attendees/{userId}": {
