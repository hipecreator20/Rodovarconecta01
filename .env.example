# ==============================================================================
# RODOVAR CONECTA — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env no desenvolvimento local ou configure na Vercel
# ==============================================================================

# OBRIGATÓRIA: String de conexão do Neon PostgreSQL (pooled connection recomendada para Serverless)
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# OBRIGATÓRIA: Chave secreta para assinatura criptográfica HMAC-SHA256 de sessões (mínimo 32 caracteres)
SESSION_SECRET="sua-chave-secreta-de-sessao-com-mais-de-32-caracteres"

# OPCIONAL / FUTURO (Fase 4): Token para armazenamento de comprovantes no Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# OPCIONAL: Porta do servidor local (padrão: 3000)
PORT=3000
