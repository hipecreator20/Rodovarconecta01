rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'indicabrasiloficiall@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)

    function isValidUserPublicProfile(data) {
      return data.keys().hasAll(['userId', 'name', 'roleTitle', 'department', 'accessLevel', 'avatar', 'phoneExt', 'joinedAt', 'active', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'name', 'roleTitle', 'department', 'accessLevel', 'avatar', 'phoneExt', 'joinedAt', 'active', 'createdAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.roleTitle is string && data.roleTitle.size() >= 2 && data.roleTitle.size() <= 120 &&
        data.department is string && data.department in ['Administrativo', 'Operacional', 'Recursos Humanos', 'Financeiro', 'Segurança', 'Diretoria', 'Logística'] &&
        data.accessLevel is string && data.accessLevel in ['FUNCIONARIO', 'ADMINISTRADOR', 'DIRETORIA'] &&
        data.avatar is string && data.avatar.size() <= 300 &&
        data.phoneExt is string && data.phoneExt.size() <= 40 &&
        data.joinedAt is string && data.joinedAt.size() <= 30 &&
        data.active is bool &&
        data.createdAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['userId', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'email', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['userId', 'role', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'role', 'createdAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.role is string && data.role in ['ADMINISTRADOR', 'DIRETORIA'] &&
        data.createdAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'summary', 'content', 'authorId', 'authorName', 'department', 'dateFormatted', 'coverImage', 'category', 'priority', 'targetAudience', 'requireReadConfirmation', 'pinned', 'createdAt']) &&
        data.keys().hasOnly(['title', 'summary', 'content', 'authorId', 'authorName', 'department', 'dateFormatted', 'coverImage', 'category', 'priority', 'targetAudience', 'requireReadConfirmation', 'pinned', 'archived', 'createdAt']) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 180 &&
        data.summary is string && data.summary.size() >= 3 && data.summary.size() <= 400 &&
        data.content is string && data.content.size() >= 3 && data.content.size() <= 5000 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 120 &&
        data.department is string && data.department.size() <= 60 &&
        data.dateFormatted is string && data.dateFormatted.size() <= 30 &&
        data.coverImage is string && data.coverImage.size() <= 300 &&
        data.category is string && data.category in ['Comunicado Geral', 'Importante', 'Urgente', 'Recursos Humanos', 'Segurança', 'Operacional', 'Eventos', 'Diretoria'] &&
        data.priority is string && data.priority in ['Normal', 'Importante', 'Urgente'] &&
        data.targetAudience is string && data.targetAudience.size() <= 60 &&
        data.requireReadConfirmation is bool &&
        data.pinned is bool &&
        (!('archived' in data) || data.archived is bool) &&
        data.createdAt is timestamp;
    }

    function isValidAnnouncementComment(data) {
      return data.keys().hasAll(['announcementId', 'authorId', 'authorName', 'authorRole', 'authorAvatar', 'content', 'createdAtFormatted', 'createdAt']) &&
        data.keys().hasOnly(['announcementId', 'authorId', 'authorName', 'authorRole', 'authorAvatar', 'content', 'createdAtFormatted', 'createdAt']) &&
        data.announcementId is string && data.announcementId.size() >= 1 && data.announcementId.size() <= 128 && data.announcementId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 120 &&
        data.authorRole is string && data.authorRole.size() <= 120 &&
        data.authorAvatar is string && data.authorAvatar.size() <= 300 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 1000 &&
        data.createdAtFormatted is string && data.createdAtFormatted.size() <= 40 &&
        data.createdAt is timestamp;
    }

    function isValidAnnouncementRead(data) {
      return data.keys().hasAll(['announcementId', 'userId', 'userName', 'department', 'confirmedAt', 'createdAt']) &&
        data.keys().hasOnly(['announcementId', 'userId', 'userName', 'department', 'confirmedAt', 'createdAt']) &&
        data.announcementId is string && data.announcementId.size() >= 1 && data.announcementId.size() <= 128 && data.announcementId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() >= 2 && data.userName.size() <= 120 &&
        data.department is string && data.department.size() <= 60 &&
        data.confirmedAt is string && data.confirmedAt.size() <= 40 &&
        data.createdAt is timestamp;
    }

    function isValidAnnouncementLike(data) {
      return data.keys().hasAll(['announcementId', 'userId', 'createdAt']) &&
        data.keys().hasOnly(['announcementId', 'userId', 'createdAt']) &&
        data.announcementId is string && data.announcementId.size() >= 1 && data.announcementId.size() <= 128 && data.announcementId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidInternalRequest(data) {
      return data.keys().hasAll(['protocol', 'requesterId', 'requesterName', 'requesterDepartment', 'targetDepartment', 'subject', 'description', 'priority', 'status', 'createdAtIso', 'originalDueAtIso', 'currentDueAtIso', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['protocol', 'requesterId', 'requesterName', 'requesterDepartment', 'targetDepartment', 'subject', 'description', 'priority', 'status', 'createdAtIso', 'originalDueAtIso', 'currentDueAtIso', 'attachmentName', 'createdAt', 'updatedAt']) &&
        data.protocol is string && data.protocol.size() <= 30 &&
        data.requesterId is string && data.requesterId.size() >= 1 && data.requesterId.size() <= 128 && data.requesterId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.requesterName is string && data.requesterName.size() >= 2 && data.requesterName.size() <= 120 &&
        data.requesterDepartment is string && data.requesterDepartment.size() <= 60 &&
        data.targetDepartment is string && data.targetDepartment.size() <= 60 &&
        data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 200 &&
        data.description is string && data.description.size() >= 3 && data.description.size() <= 3000 &&
        data.priority is string && data.priority in ['Baixa', 'Média', 'Alta', 'Urgente'] &&
        data.status is string && data.status in ['Aberta', 'Em análise', 'Em andamento', 'Aguardando funcionário', 'Concluída', 'Cancelada'] &&
        data.createdAtIso is string && data.createdAtIso.size() <= 40 &&
        data.originalDueAtIso is string && data.originalDueAtIso.size() <= 40 &&
        data.currentDueAtIso is string && data.currentDueAtIso.size() <= 40 &&
        (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() <= 200)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRequestHistory(data) {
      return data.keys().hasAll(['requestId', 'actorId', 'actorName', 'action', 'timestamp', 'createdAt']) &&
        data.keys().hasOnly(['requestId', 'actorId', 'actorName', 'action', 'note', 'timestamp', 'createdAt']) &&
        data.requestId is string && data.requestId.size() >= 1 && data.requestId.size() <= 128 && data.requestId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.actorId is string && data.actorId.size() >= 1 && data.actorId.size() <= 128 && data.actorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.actorId == request.auth.uid &&
        data.actorName is string && data.actorName.size() >= 2 && data.actorName.size() <= 120 &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 400 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        data.timestamp is string && data.timestamp.size() <= 40 &&
        data.createdAt is timestamp;
    }

    function isValidCorporateEvent(data) {
      return data.keys().hasAll(['day', 'monthShort', 'dateIso', 'time', 'location', 'title', 'organizer', 'department', 'badgeLabel', 'badgeColor', 'description', 'authorId', 'createdAt']) &&
        data.keys().hasOnly(['day', 'monthShort', 'dateIso', 'time', 'location', 'title', 'organizer', 'department', 'badgeLabel', 'badgeColor', 'description', 'authorId', 'createdAt']) &&
        data.day is string && data.day.size() <= 4 &&
        data.monthShort is string && data.monthShort.size() <= 10 &&
        data.dateIso is string && data.dateIso.size() <= 20 &&
        data.time is string && data.time.size() <= 40 &&
        data.location is string && data.location.size() <= 160 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 180 &&
        data.organizer is string && data.organizer.size() <= 120 &&
        data.department is string && data.department.size() <= 60 &&
        data.badgeLabel is string && data.badgeLabel in ['Importante', 'Evento', 'Reunião', 'Treinamento', 'TREINAMENTO SSMA', 'REUNIÃO EXECUTIVA', 'INTEGRAÇÃO RH'] &&
        data.badgeColor is string && data.badgeColor in ['red', 'blue', 'gray'] &&
        data.description is string && data.description.size() <= 2000 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidEventAttendee(data) {
      return data.keys().hasAll(['eventId', 'userId', 'userName', 'createdAt']) &&
        data.keys().hasOnly(['eventId', 'userId', 'userName', 'createdAt']) &&
        data.eventId is string && data.eventId.size() >= 1 && data.eventId.size() <= 128 && data.eventId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidCorporateDocument(data) {
      return data.keys().hasAll(['title', 'category', 'version', 'updatedAt', 'author', 'authorId', 'size', 'fileType', 'allowedDepartments', 'description', 'contentPreview', 'createdAt']) &&
        data.keys().hasOnly(['title', 'category', 'version', 'updatedAt', 'author', 'authorId', 'size', 'fileType', 'allowedDepartments', 'description', 'contentPreview', 'createdAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 180 &&
        data.category is string && data.category in ['Políticas da Empresa', 'Manual do Colaborador', 'Recursos Humanos', 'Segurança do Trabalho', 'Formulários', 'Treinamentos', 'Documentos Administrativos'] &&
        data.version is string && data.version.size() <= 20 &&
        data.updatedAt is string && data.updatedAt.size() <= 30 &&
        data.author is string && data.author.size() <= 120 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId == request.auth.uid &&
        data.size is string && data.size.size() <= 30 &&
        data.fileType is string && data.fileType in ['PDF', 'DOCX', 'XLSX'] &&
        data.allowedDepartments is string && data.allowedDepartments.size() <= 60 &&
        data.description is string && data.description.size() <= 1500 &&
        data.contentPreview is string && data.contentPreview.size() <= 4000 &&
        data.createdAt is timestamp;
    }

    function isValidEmployeeInvite(data) {
      return data.keys().hasAll(['fullName', 'email', 'roleTitle', 'department', 'accessLevel', 'token', 'expiresAt', 'status', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['fullName', 'email', 'roleTitle', 'department', 'accessLevel', 'token', 'expiresAt', 'status', 'createdBy', 'createdAt']) &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.roleTitle is string && data.roleTitle.size() >= 2 && data.roleTitle.size() <= 120 &&
        data.department is string && data.department.size() <= 60 &&
        data.accessLevel is string && data.accessLevel in ['FUNCIONARIO', 'ADMINISTRADOR', 'DIRETORIA'] &&
        data.token is string && data.token.size() <= 64 &&
        data.expiresAt is string && data.expiresAt.size() <= 40 &&
        data.status is string && data.status in ['Pendente', 'Ativado', 'Expirado'] &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 && data.createdBy.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdBy == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['timestamp', 'actorId', 'actor', 'role', 'action', 'details', 'createdAt']) &&
        data.keys().hasOnly(['timestamp', 'actorId', 'actor', 'role', 'action', 'details', 'createdAt']) &&
        data.timestamp is string && data.timestamp.size() <= 40 &&
        data.actorId is string && data.actorId.size() >= 1 && data.actorId.size() <= 128 && data.actorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.actorId == request.auth.uid &&
        data.actor is string && data.actor.size() <= 120 &&
        data.role is string && data.role in ['FUNCIONARIO', 'ADMINISTRADOR', 'DIRETORIA'] &&
        data.action is string && data.action.size() <= 80 &&
        data.details is string && data.details.size() <= 600 &&
        data.createdAt is timestamp;
    }

    function isValidChatThread(data) {
      return data.keys().hasAll(['isGroup', 'name', 'roleOrDept', 'department', 'participantsCount', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['isGroup', 'name', 'roleOrDept', 'department', 'pinnedNotice', 'participantsCount', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.isGroup is bool &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 140 &&
        data.roleOrDept is string && data.roleOrDept.size() <= 160 &&
        data.department is string && data.department in ['Todos', 'Administrativo', 'Operacional', 'Recursos Humanos', 'Financeiro', 'Segurança', 'Diretoria', 'Logística'] &&
        (!('pinnedNotice' in data) || (data.pinnedNotice is string && data.pinnedNotice.size() <= 400)) &&
        data.participantsCount is int && data.participantsCount >= 1 && data.participantsCount <= 1000 &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 && data.createdBy.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['chatId', 'senderId', 'senderName', 'text', 'timestamp', 'status', 'createdAt']) &&
        data.keys().hasOnly(['chatId', 'senderId', 'senderName', 'senderRole', 'text', 'timestamp', 'status', 'attachmentName', 'attachmentSize', 'pinned', 'createdAt']) &&
        data.chatId is string && data.chatId.size() >= 1 && data.chatId.size() <= 128 && data.chatId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 && data.senderId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 120 &&
        (!('senderRole' in data) || (data.senderRole is string && data.senderRole.size() <= 120)) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
        data.timestamp is string && data.timestamp.size() <= 40 &&
        data.status is string && data.status in ['delivered', 'read'] &&
        (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() <= 200)) &&
        (!('attachmentSize' in data) || (data.attachmentSize is string && data.attachmentSize.size() <= 30)) &&
        (!('pinned' in data) || data.pinned is bool) &&
        data.createdAt is timestamp;
    }

    function isValidChatParticipant(data) {
      return data.keys().hasAll(['chatId', 'userId', 'userName', 'department', 'roleTitle', 'createdAt']) &&
        data.keys().hasOnly(['chatId', 'userId', 'userName', 'department', 'roleTitle', 'createdAt']) &&
        data.chatId is string && data.chatId.size() >= 1 && data.chatId.size() <= 128 && data.chatId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userName is string && data.userName.size() >= 2 && data.userName.size() <= 120 &&
        data.department is string && data.department.size() <= 60 &&
        data.roleTitle is string && data.roleTitle.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidCorporateNotification(data) {
      return data.keys().hasAll(['recipientId', 'type', 'dotColor', 'title', 'subtitle', 'timeLabel', 'read', 'targetSection', 'createdAt']) &&
        data.keys().hasOnly(['recipientId', 'type', 'dotColor', 'title', 'subtitle', 'timeLabel', 'read', 'targetSection', 'targetId', 'createdAt']) &&
        data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128 && data.recipientId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.type is string && data.type in ['comunicado', 'mensagem', 'solicitacao', 'alerta_sla', 'evento', 'documento', 'prazo'] &&
        data.dotColor is string && data.dotColor in ['red', 'blue'] &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.subtitle is string && data.subtitle.size() >= 2 && data.subtitle.size() <= 240 &&
        data.timeLabel is string && data.timeLabel.size() <= 40 &&
        data.read is bool &&
        data.targetSection is string && data.targetSection.size() <= 40 &&
        (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128)) &&
        data.createdAt is timestamp;
    }

    function isValidFreightFinancialRecord(data) {
      return data.keys().hasAll([
          'code', 'createdAtDate', 'createdAtIso', 'cliente', 'origem', 'destino',
          'dataColeta', 'dataEntrega', 'regraTipo', 'regraLabel', 'percentualAdiantamento',
          'percentualSaldo', 'valorTotal', 'valorAdiantamento', 'valorSaldo', 'favorecido',
          'banco', 'agencia', 'conta', 'tipoChavePix', 'chavePix', 'status',
          'adiantamentoPago', 'entregaConfirmada', 'saldoPago', 'solicitanteNome', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'code', 'createdAtDate', 'createdAtIso', 'empresaMarca', 'dataCarregamento',
          'unidadeOperacional', 'comercialResponsavel', 'expedicaoResponsavel', 'cliente',
          'telefoneCliente', 'motoristaNome', 'motoristaTelefone', 'emergenciaNome',
          'emergenciaTelefone', 'origem', 'destino', 'dataColeta', 'dataEntrega',
          'valorFreteEmpresa', 'valorFreteMotorista', 'regraTipo', 'regraLabel',
          'percentualAdiantamento', 'percentualSaldo', 'valorTotal', 'valorAdiantamento',
          'valorSaldo', 'favorecido', 'banco', 'agencia', 'conta', 'tipoChavePix',
          'chavePix', 'status', 'adiantamentoPago', 'adiantamentoPagoEm',
          'codigoTransacaoAdiantamento', 'entregaConfirmada', 'entregaConfirmadaEm',
          'saldoPago', 'saldoPagoEm', 'codigoTransacaoSaldo', 'observacoes',
          'solicitanteNome', 'updatedAt'
        ]) &&
        data.code is string && data.code.size() <= 20 &&
        data.createdAtDate is string && data.createdAtDate.size() <= 20 &&
        data.createdAtIso is string && data.createdAtIso.size() <= 40 &&
        (!('empresaMarca' in data) || data.empresaMarca in ['RODOVAR', 'VL TRANSPORTES', 'AXD']) &&
        (!('dataCarregamento' in data) || (data.dataCarregamento is string && data.dataCarregamento.size() <= 20)) &&
        (!('unidadeOperacional' in data) || data.unidadeOperacional in ['BA - Salvador', 'SP - Guarulhos']) &&
        (!('comercialResponsavel' in data) || (data.comercialResponsavel is string && data.comercialResponsavel.size() <= 120)) &&
        (!('expedicaoResponsavel' in data) || (data.expedicaoResponsavel is string && data.expedicaoResponsavel.size() <= 120)) &&
        data.cliente is string && data.cliente.size() >= 2 && data.cliente.size() <= 120 &&
        (!('telefoneCliente' in data) || (data.telefoneCliente is string && data.telefoneCliente.size() <= 30)) &&
        (!('motoristaNome' in data) || (data.motoristaNome is string && data.motoristaNome.size() <= 120)) &&
        (!('motoristaTelefone' in data) || (data.motoristaTelefone is string && data.motoristaTelefone.size() <= 30)) &&
        (!('emergenciaNome' in data) || (data.emergenciaNome is string && data.emergenciaNome.size() <= 120)) &&
        (!('emergenciaTelefone' in data) || (data.emergenciaTelefone is string && data.emergenciaTelefone.size() <= 30)) &&
        data.origem is string && data.origem.size() >= 2 && data.origem.size() <= 140 &&
        data.destino is string && data.destino.size() >= 2 && data.destino.size() <= 140 &&
        data.dataColeta is string && data.dataColeta.size() <= 20 &&
        data.dataEntrega is string && data.dataEntrega.size() <= 20 &&
        (!('valorFreteEmpresa' in data) || data.valorFreteEmpresa is number) &&
        (!('valorFreteMotorista' in data) || data.valorFreteMotorista is number) &&
        data.regraTipo in ['70_30', 'INTEGRAL_100', 'PERSONALIZADO'] &&
        data.regraLabel is string && data.regraLabel.size() <= 40 &&
        data.percentualAdiantamento is number &&
        data.percentualSaldo is number &&
        data.valorTotal is number &&
        data.valorAdiantamento is number &&
        data.valorSaldo is number &&
        data.favorecido is string && data.favorecido.size() >= 2 && data.favorecido.size() <= 120 &&
        data.banco is string && data.banco.size() <= 80 &&
        data.agencia is string && data.agencia.size() <= 30 &&
        data.conta is string && data.conta.size() <= 40 &&
        data.tipoChavePix in ['CPF/CNPJ', 'Celular', 'E-mail', 'Chave Aleatória'] &&
        data.chavePix is string && data.chavePix.size() <= 120 &&
        data.status in ['Pendente Adiantamento', 'Adiantamento Pago', 'Aguardando Entrega', 'Pendente Saldo', 'Pago'] &&
        data.adiantamentoPago is bool &&
        (!('adiantamentoPagoEm' in data) || (data.adiantamentoPagoEm is string && data.adiantamentoPagoEm.size() <= 40)) &&
        (!('codigoTransacaoAdiantamento' in data) || (data.codigoTransacaoAdiantamento is string && data.codigoTransacaoAdiantamento.size() <= 60)) &&
        data.entregaConfirmada is bool &&
        (!('entregaConfirmadaEm' in data) || (data.entregaConfirmadaEm is string && data.entregaConfirmadaEm.size() <= 40)) &&
        data.saldoPago is bool &&
        (!('saldoPagoEm' in data) || (data.saldoPagoEm is string && data.saldoPagoEm.size() <= 40)) &&
        (!('codigoTransacaoSaldo' in data) || (data.codigoTransacaoSaldo is string && data.codigoTransacaoSaldo.size() <= 60)) &&
        (!('observacoes' in data) || (data.observacoes is string && data.observacoes.size() <= 1000)) &&
        data.solicitanteNome is string && data.solicitanteNome.size() <= 120 &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // COLLECTION RULES
    // =========================================================================

    // 1. User Public Profiles (/users/{userId}/public/{profileId})
    match /users/{userId}/public/{profileId} {
      allow get: if isVerifiedUser() && isValidId(userId) && isValidId(profileId);
      allow list: if isVerifiedUser() && existing().active == true;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidId(profileId) &&
        isValidUserPublicProfile(incoming()) &&
        incoming().createdAt == request.time &&
        (
          isAdmin() ||
          (isOwner(userId) && incoming().userId == request.auth.uid && incoming().accessLevel == 'FUNCIONARIO')
        );
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidId(profileId) &&
        isValidUserPublicProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().accessLevel == existing().accessLevel &&
            incoming().department == existing().department &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'phoneExt'])
          )
        );
      allow delete: if isAdmin() && isValidId(userId) && isValidId(profileId);
    }

    // 2. User Private Info — Strictly Isolated PII (/users/{userId}/private/{infoId})
    match /users/{userId}/private/{infoId} {
      allow get: if isVerifiedUser() && isValidId(userId) && isValidId(infoId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && existing().userId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidId(infoId) &&
        isValidUserPrivateInfo(incoming()) &&
        incoming().updatedAt == request.time &&
        (isOwner(userId) || isAdmin()) &&
        incoming().userId == userId;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidId(infoId) &&
        isValidUserPrivateInfo(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(userId) && isValidId(infoId);
    }

    // 3. Admins Role Lookup (/admins/{userId})
    match /admins/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isAdmin() &&
        isValidId(userId) &&
        isValidAdminRecord(incoming()) &&
        incoming().userId == userId &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(userId) &&
        isValidAdminRecord(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['role']);
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 4. Official Announcements (/announcements/{announcementId})
    match /announcements/{announcementId} {
      allow get: if isVerifiedUser() && isValidId(announcementId);
      allow list: if isVerifiedUser() && existing().targetAudience in ['Todos', 'Administrativo', 'Operacional', 'Recursos Humanos', 'Financeiro', 'Segurança', 'Diretoria', 'Logística'];
      allow create: if isAdmin() &&
        isValidId(announcementId) &&
        isValidAnnouncement(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(announcementId) &&
        isValidAnnouncement(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'content', 'category', 'priority', 'pinned', 'archived', 'targetAudience', 'requireReadConfirmation', 'coverImage']);
      allow delete: if isAdmin() && isValidId(announcementId);

      // 4a. Announcement Comments (/announcements/{announcementId}/comments/{commentId})
      match /comments/{commentId} {
        allow get: if isVerifiedUser() && isValidId(announcementId) && isValidId(commentId) &&
          exists(/databases/$(database)/documents/announcements/$(announcementId));
        allow list: if isVerifiedUser() && existing().announcementId == announcementId;
        allow create: if isVerifiedUser() &&
          isValidId(announcementId) &&
          isValidId(commentId) &&
          isValidAnnouncementComment(incoming()) &&
          incoming().announcementId == announcementId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/announcements/$(announcementId));
        allow update: if false;
        allow delete: if isAdmin() && isValidId(announcementId) && isValidId(commentId);
      }

      // 4b. Mandatory Read Confirmations (/announcements/{announcementId}/reads/{userId})
      match /reads/{userId} {
        allow get: if isVerifiedUser() && isValidId(announcementId) && isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() &&
          isValidId(announcementId) &&
          isValidId(userId) &&
          isOwner(userId) &&
          isValidAnnouncementRead(incoming()) &&
          incoming().announcementId == announcementId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/announcements/$(announcementId));
        allow update: if false;
        allow delete: if false;
      }

      // 4c. Announcement Likes (/announcements/{announcementId}/likes/{userId})
      match /likes/{userId} {
        allow get: if isVerifiedUser() && isValidId(announcementId) && isValidId(userId);
        allow list: if isVerifiedUser() && existing().announcementId == announcementId;
        allow create: if isVerifiedUser() &&
          isValidId(announcementId) &&
          isValidId(userId) &&
          isOwner(userId) &&
          isValidAnnouncementLike(incoming()) &&
          incoming().announcementId == announcementId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/announcements/$(announcementId));
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(announcementId) && isValidId(userId) && isOwner(userId);
      }
    }

    // 5. Internal Requests with 48h SLA (/requests/{requestId})
    match /requests/{requestId} {
      allow get: if isVerifiedUser() && isValidId(requestId) && (existing().requesterId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().requesterId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(requestId) &&
        isValidInternalRequest(incoming()) &&
        incoming().requesterId == request.auth.uid &&
        incoming().status == 'Aberta' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(requestId) &&
        isValidInternalRequest(incoming()) &&
        incoming().requesterId == existing().requesterId &&
        incoming().protocol == existing().protocol &&
        incoming().originalDueAtIso == existing().originalDueAtIso &&
        incoming().createdAtIso == existing().createdAtIso &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().requesterId == request.auth.uid &&
            !(existing().status in ['Concluída', 'Cancelada']) &&
            incoming().currentDueAtIso == existing().currentDueAtIso &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            incoming().status == 'Cancelada'
          )
        );
      allow delete: if isAdmin() && isValidId(requestId);

      // 5a. Request History (/requests/{requestId}/history/{historyId})
      match /history/{historyId} {
        allow get: if isVerifiedUser() && isValidId(requestId) && isValidId(historyId) &&
          (get(/databases/$(database)/documents/requests/$(requestId)).data.requesterId == request.auth.uid || isAdmin());
        allow list: if isVerifiedUser() && (existing().actorId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() &&
          isValidId(requestId) &&
          isValidId(historyId) &&
          isValidRequestHistory(incoming()) &&
          incoming().requestId == requestId &&
          incoming().createdAt == request.time &&
          (
            get(/databases/$(database)/documents/requests/$(requestId)).data.requesterId == request.auth.uid ||
            isAdmin()
          );
        allow update: if false;
        allow delete: if false;
      }
    }

    // 6. Corporate Events (/events/{eventId})
    match /events/{eventId} {
      allow get: if isVerifiedUser() && isValidId(eventId);
      allow list: if isVerifiedUser() && existing().department in ['Empresa', 'Administrativo', 'Operacional', 'Recursos Humanos', 'Financeiro', 'Segurança', 'Diretoria', 'Logística'];
      allow create: if isAdmin() &&
        isValidId(eventId) &&
        isValidCorporateEvent(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(eventId) &&
        isValidCorporateEvent(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['day', 'monthShort', 'dateIso', 'time', 'location', 'title', 'description', 'badgeLabel', 'badgeColor']);
      allow delete: if isAdmin() && isValidId(eventId);

      // 6a. Event Attendees (/events/{eventId}/attendees/{userId})
      match /attendees/{userId} {
        allow get: if isVerifiedUser() && isValidId(eventId) && isValidId(userId);
        allow list: if isVerifiedUser() && existing().eventId == eventId;
        allow create: if isVerifiedUser() &&
          isValidId(eventId) &&
          isValidId(userId) &&
          isOwner(userId) &&
          isValidEventAttendee(incoming()) &&
          incoming().eventId == eventId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/events/$(eventId));
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(eventId) && isValidId(userId) && isOwner(userId);
      }
    }

    // 7. Corporate Documents (/documents/{documentId})
    match /documents/{documentId} {
      allow get: if isVerifiedUser() && isValidId(documentId);
      allow list: if isVerifiedUser() && existing().allowedDepartments in ['Todos', 'Administrativo', 'Operacional', 'Recursos Humanos', 'Financeiro', 'Segurança', 'Diretoria', 'Logística'];
      allow create: if isAdmin() &&
        isValidId(documentId) &&
        isValidCorporateDocument(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(documentId) &&
        isValidCorporateDocument(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'version', 'updatedAt', 'description', 'contentPreview']);
      allow delete: if isAdmin() && isValidId(documentId);
    }

    // 8. Employee Invites (/invites/{inviteId})
    match /invites/{inviteId} {
      allow get: if isAdmin() && isValidId(inviteId);
      allow list: if isAdmin() && existing().status in ['Pendente', 'Ativado', 'Expirado'];
      allow create: if isAdmin() &&
        isValidId(inviteId) &&
        isValidEmployeeInvite(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(inviteId) &&
        isValidEmployeeInvite(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().token == existing().token &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin() && isValidId(inviteId);
    }

    // 9. Administrative Audit Logs (/audit_logs/{logId})
    match /audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin() && existing().role in ['FUNCIONARIO', 'ADMINISTRADOR', 'DIRETORIA'];
      allow create: if isAdmin() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    // 10. Corporate Chats & Groups (/chats/{chatId})
    match /chats/{chatId} {
      allow get: if isVerifiedUser() && isValidId(chatId);
      allow list: if isVerifiedUser() && existing().department in ['Todos', 'Administrativo', 'Operacional', 'Recursos Humanos', 'Financeiro', 'Segurança', 'Diretoria', 'Logística'];
      allow create: if isVerifiedUser() &&
        isValidId(chatId) &&
        isValidChatThread(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (!incoming().isGroup || isAdmin());
      allow update: if isVerifiedUser() &&
        isValidId(chatId) &&
        isValidChatThread(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'pinnedNotice', 'participantsCount'])
        );
      allow delete: if isAdmin() && isValidId(chatId);

      // 10a. Chat Messages (/chats/{chatId}/messages/{messageId})
      match /messages/{messageId} {
        allow get: if isVerifiedUser() && isValidId(chatId) && isValidId(messageId) &&
          exists(/databases/$(database)/documents/chats/$(chatId));
        allow list: if isVerifiedUser() && existing().chatId == chatId;
        allow create: if isVerifiedUser() &&
          isValidId(chatId) &&
          isValidId(messageId) &&
          isValidChatMessage(incoming()) &&
          incoming().chatId == chatId &&
          incoming().senderId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/chats/$(chatId));
        allow update: if isVerifiedUser() &&
          isValidId(chatId) &&
          isValidId(messageId) &&
          isValidChatMessage(incoming()) &&
          incoming().chatId == existing().chatId &&
          incoming().senderId == existing().senderId &&
          incoming().createdAt == existing().createdAt &&
          (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'pinned'])
          );
        allow delete: if isVerifiedUser() && isValidId(chatId) && isValidId(messageId) &&
          (existing().senderId == request.auth.uid || isAdmin());
      }

      // 10b. Chat Participants (/chats/{chatId}/participants/{userId})
      match /participants/{userId} {
        allow get: if isVerifiedUser() && isValidId(chatId) && isValidId(userId) &&
          exists(/databases/$(database)/documents/chats/$(chatId));
        allow list: if isVerifiedUser() && existing().chatId == chatId;
        allow create: if isVerifiedUser() &&
          isValidId(chatId) &&
          isValidId(userId) &&
          isValidChatParticipant(incoming()) &&
          incoming().chatId == chatId &&
          incoming().userId == userId &&
          incoming().createdAt == request.time &&
          (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/chats/$(chatId));
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(chatId) && isValidId(userId) &&
          (isOwner(userId) || isAdmin());
      }
    }

    // 11. Corporate Real-Time Notifications (/notifications/{notificationId})
    match /notifications/{notificationId} {
      allow get: if isVerifiedUser() && isValidId(notificationId) &&
        (existing().recipientId == request.auth.uid || existing().recipientId == 'ALL' || isAdmin());
      allow list: if isVerifiedUser() &&
        existing().recipientId in [request.auth.uid, 'ALL'];
      allow create: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidCorporateNotification(incoming()) &&
        incoming().createdAt == request.time &&
        (incoming().recipientId == request.auth.uid || isAdmin());
      allow update: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidCorporateNotification(incoming()) &&
        incoming().recipientId == existing().recipientId &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() ||
          (
            (existing().recipientId == request.auth.uid || existing().recipientId == 'ALL') &&
            incoming().diff(existing()).affectedKeys().hasOnly(['read'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(notificationId) &&
        (existing().recipientId == request.auth.uid || isAdmin());
    }

    // 12. Corporate Freight Financial Records (/fretes_financeiro/{freightId})
    match /fretes_financeiro/{freightId} {
      allow get: if isVerifiedUser() && isValidId(freightId);
      allow list: if isVerifiedUser() && existing().status in ['Pendente Adiantamento', 'Adiantamento Pago', 'Aguardando Entrega', 'Pendente Saldo', 'Pago'];
      allow create: if isVerifiedUser() &&
        isValidId(freightId) &&
        isValidFreightFinancialRecord(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(freightId) &&
        isValidFreightFinancialRecord(incoming()) &&
        incoming().code == existing().code &&
        incoming().createdAtIso == existing().createdAtIso &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(freightId);
    }

    // 13. Payment Intents (/payment_intents/{intentId})
    match /payment_intents/{intentId} {
      allow get: if isVerifiedUser() && isValidId(intentId) &&
        (existing().responsibleUserId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() &&
        existing().responsibleUserId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(intentId) &&
        incoming().responsibleUserId == request.auth.uid &&
        incoming().installmentType in ['ADIANTAMENTO', 'SALDO'] &&
        incoming().status == 'AGUARDANDO_COMPROVANTE' &&
        incoming().expectedAmountCentavos is int &&
        incoming().expectedAmountCentavos > 0 &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(intentId) &&
        incoming().responsibleUserId == existing().responsibleUserId &&
        incoming().freightId == existing().freightId &&
        incoming().installmentType == existing().installmentType &&
        (existing().responsibleUserId == request.auth.uid || isAdmin()) &&
        incoming().status in ['AGUARDANDO_COMPROVANTE', 'COMPROVANTE_VINCULADO', 'CONCLUIDA', 'EXPIRADA', 'CANCELADA'];
      allow delete: if isAdmin() && isValidId(intentId);
    }

    // 14. Payment Receipt Metadata (/payment_receipts/{receiptId})
    // Binary files are stored in private server/Cloud Storage, NEVER as Base64 in Firestore
    match /payment_receipts/{receiptId} {
      allow get: if isVerifiedUser() && isValidId(receiptId);
      allow list: if isVerifiedUser() &&
        existing().installmentType in ['ADIANTAMENTO', 'SALDO'];
      allow create: if isVerifiedUser() &&
        isValidId(receiptId) &&
        incoming().uploadedByUserId == request.auth.uid &&
        incoming().installmentType in ['ADIANTAMENTO', 'SALDO'] &&
        incoming().mimeType in ['application/pdf', 'image/jpeg', 'image/png'] &&
        incoming().sizeBytes is int &&
        incoming().sizeBytes > 0 &&
        incoming().sizeBytes <= 10485760 &&
        incoming().verificationStatus == 'AGUARDANDO_CONFERENCIA' &&
        !('fileBase64' in incoming()) &&
        !('dataUrl' in incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(receiptId) &&
        incoming().freightId == existing().freightId &&
        incoming().installmentType == existing().installmentType &&
        incoming().sha256Hash == existing().sha256Hash &&
        incoming().verificationStatus in ['AGUARDANDO_CONFERENCIA', 'PAGAMENTO_CONFIRMADO', 'REJEITADO'];
      allow delete: if false; // Audit trail preservation: receipts are never silently deleted
    }
  }
}

